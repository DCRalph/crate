# Copy to .env.local and fill in.

DATABASE_URL="postgresql://postgres:postgres@localhost:5439/crate"

# openssl rand -base64 32
# Also encrypts app passwords at rest. Changing it invalidates every app password.
BETTER_AUTH_SECRET=""
# Public origin, e.g. https://music.example.com
BETTER_AUTH_URL="http://localhost:3000"

# Where the cover art cache lives. Safe to delete.
DATA_DIR="./data"

# Optional: rescan every library on this interval. Leave unset to scan by hand.
# SCAN_INTERVAL_MINUTES="60"
